{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/navigation/**",
              "ui_kits/personal-dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Boogaloo|Caveat|Inter))/i]",
        "message": "Font not provided by the design system. Available: Boogaloo, Caveat, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|children|onClick|key|ref|className|style|children)$/]",
        "message": "<ArrowButton> doesn't accept that prop. Declared props: direction, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowButton'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<ArrowButton> direction must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateStamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<DateStamp> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndexCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<IndexCard> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: page."
      },
      {
        "selector": "JSXOpeningElement[name.name='Orb'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|key|ref|className|style|children)$/]",
        "message": "<Orb> doesn't accept that prop. Declared props: size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|placeholder|value|onChange|key|ref|className|style|children)$/]",
        "message": "<PaperCard> doesn't accept that prop. Declared props: children, placeholder, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnreadDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|key|ref|className|style|children)$/]",
        "message": "<UnreadDot> doesn't accept that prop. Declared props: style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "ArrowButton": {
        "replaces": []
      },
      "Button": {
        "replaces": []
      },
      "DateStamp": {
        "replaces": []
      },
      "EmptyState": {
        "replaces": []
      },
      "IndexCard": {
        "replaces": []
      },
      "NavBar": {
        "replaces": []
      },
      "Orb": {
        "replaces": []
      },
      "PageHeader": {
        "replaces": []
      },
      "PaperCard": {
        "replaces": []
      },
      "UnreadDot": {
        "replaces": []
      }
    },
    "tokens": [
      "--arrow-pink",
      "--bg",
      "--font-accent",
      "--font-display",
      "--font-ui",
      "--hairline",
      "--headline-fill",
      "--ink",
      "--max-width",
      "--nav-active",
      "--nav-bg",
      "--nav-height",
      "--nav-inactive",
      "--orb-core",
      "--orb-highlight",
      "--paper",
      "--paper-shadow",
      "--radius-lg",
      "--radius-sm",
      "--shadow-soft",
      "--space-section",
      "--tape",
      "--text-accent",
      "--text-body",
      "--text-date",
      "--text-hero",
      "--text-label",
      "--text-muted",
      "--text-nav",
      "--text-page-header",
      "--text-primary",
      "--text-secondary"
    ],
    "tokenKinds": {
      "--ink": "color",
      "--arrow-pink": "color",
      "--nav-bg": "color",
      "--nav-active": "color",
      "--nav-inactive": "color",
      "--paper": "color",
      "--paper-shadow": "shadow",
      "--tape": "color",
      "--hairline": "color",
      "--bg": "color",
      "--orb-core": "color",
      "--orb-highlight": "color",
      "--headline-fill": "color",
      "--text-muted": "font",
      "--text-primary": "font",
      "--text-secondary": "font",
      "--font-display": "font",
      "--font-accent": "font",
      "--font-ui": "font",
      "--text-hero": "font",
      "--text-page-header": "font",
      "--text-accent": "font",
      "--text-date": "font",
      "--text-nav": "font",
      "--text-body": "font",
      "--text-label": "font",
      "--radius-sm": "radius",
      "--radius-lg": "radius",
      "--nav-height": "spacing",
      "--space-section": "spacing",
      "--max-width": "spacing",
      "--shadow-soft": "shadow"
    },
    "fontFamilies": [
      "Boogaloo",
      "Caveat",
      "Inter"
    ]
  }
}